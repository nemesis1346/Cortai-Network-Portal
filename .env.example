# Copy this file to .env and fill in real values. .env is gitignored.

# Vite build-time vars (see src/api/index.ts, src/vite-env.d.ts)
# Service layer: everything the UI can ask a backend for lives behind the single
# PortalApi interface in src/api/. Set to "false" to use a real PortalApi
# implementation instead of the bundled mock; unset/anything else = mock.
VITE_USE_MOCK=true
VITE_API_BASE_URL=
VITE_SITE_ID=default
VITE_WS_BASE_URL=

# EC2 deploy vars (see deploy/scripts/deploy-ec2.sh)
EC2_HOST=ec2-xx-xx-xx-xx.region.compute.amazonaws.com
EC2_KEY=deploy/cortai.pem
EC2_USER=ubuntu
